+        bill.setTienPhong(calculated.getTienPhong()); bill.setTienDichVu(calculated.getTienDichVu());
+        bill.setTongTien(calculated.getTongTien()); bill.setNgayLap(now); bill.setTrangThai("Đã thanh toán");
