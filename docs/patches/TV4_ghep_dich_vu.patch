+        stay.setTrangThai("Đã trả phòng"); stay.setNgayTraPhong(now);
+        Room room = stay.getPhong(); room.setTrangThai("Còn trống"); rooms.save(room);
+        return bills.saveAndFlush(bill).getMaHoaDon();
+    }
