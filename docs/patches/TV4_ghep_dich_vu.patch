+package org.example.quan_li_khach_san.service;
+
+import org.example.quan_li_khach_san.entity.*;
+import org.example.quan_li_khach_san.repository.*;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import java.math.BigDecimal;
+import java.time.Duration;
+import java.time.LocalDateTime;
+
+/** Integration adapter for TV4: serialize final billing with TV3 orders on the same stay. */
+@Service
+@Transactional(readOnly = true)
+public class ThanhToanService {
+    private final DatPhongRepository stays;
+    private final HoaDonRepository bills;
+    private final SuDungDichVuRepository usages;
+    private final RoomRepository rooms;
+    public ThanhToanService(DatPhongRepository stays, HoaDonRepository bills,
+                           SuDungDichVuRepository usages, RoomRepository rooms) {
+        this.stays = stays; this.bills = bills; this.usages = usages; this.rooms = rooms;
+    }
+    public HoaDon xemTruoc(String soPhong) {
+        DatPhong stay = stays.findFirstBySoPhongAndTrangThaiOrderByNgayNhanPhongDesc(soPhong, "Đang lưu trú")
+                .orElseThrow(() -> new DichVuNotFoundException("Không tìm thấy lượt đang lưu trú của phòng."));
+        return tinhTien(stay, LocalDateTime.now());
+    }
+    public long soNgayTinhPhi(DatPhong stay, LocalDateTime now) {
+        // Keep TV4's existing rule: full 24-hour periods, minimum one day.
+        return Math.max(1, Duration.between(stay.getNgayNhanPhong(), now).toDays());
+    }
+    private HoaDon tinhTien(DatPhong stay, LocalDateTime now) {
+        if (!stay.isDangLuuTru() || stay.getNgayNhanPhong() == null || stay.getNgayNhanPhong().isAfter(now))
+            throw new DichVuException("Lượt lưu trú không hợp lệ hoặc đã trả phòng.");
+        BigDecimal price = BigDecimal.valueOf(stay.getPhong().getGiaPhong());
+        if (price == null || price.signum() < 0) throw new DichVuException("Giá phòng không hợp lệ.");
+        HoaDon bill = new HoaDon(); bill.setDatPhong(stay); bill.setMaDatPhong(stay.getMaDatPhong());
+        bill.setTienPhong(price.multiply(BigDecimal.valueOf(soNgayTinhPhi(stay, now))));
+        bill.setTienDichVu(usages.tongTienTheoLuotO(stay.getMaDatPhong()));
